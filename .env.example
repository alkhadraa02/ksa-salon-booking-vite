# Copy to .env and change the values before any real deployment.

# Admin account created on first start (if it does not exist yet).
# Defaults for local development only - change them for any real use.
ADMIN_EMAIL=admin@salon.example
ADMIN_PASSWORD=ChangeMe-Admin-123

# API port in development (the Vite dev server runs on 3111 and proxies /api here).
API_PORT=3112

# Port of `npm start` (serves the built SPA and the API together).
PORT=3111

# SQLite database file (gitignored).
DB_PATH=data/salon.db

# Public URL used in sitemap.xml / robots.txt.
SITE_URL=http://localhost:3111

# Salon time zone used for "today" and past-slot checks.
SALON_TZ=Asia/Riyadh

# Set to true only when served over HTTPS (adds the Secure flag to the session cookie).
COOKIE_SECURE=false
